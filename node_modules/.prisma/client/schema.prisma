// ============================================================================
// DIY PARTY WORKSHOP — Нэгдсэн ПОС Систем (ЗАСВАРЛАСАН ХУВИЛБАР v2)
// ----------------------------------------------------------------------------
// Энэ файл нь таны илгээсэн schema дээр илэрсэн 6 асуудлыг засаж, өмнөх
// ярианд бэлдсэн Payment/GatewayTransaction/StockMovement логиктой нэгтгэсэн
// БҮРЭН, эцсийн хувилбар юм. Хуучин schema.prisma + schema-addition*.prisma
// 3 файлыг ЭНЭ ГАНЦ файлаар орлуулж болно.
//
// Засварласан зүйлс (тоор дугаарлав, доор кодон дотор ✅ тэмдэгээр дахин
// зааж өгсөн):
//   1. Float → Decimal бүх мөнгөн дүнд
//   2. RentalDetail квант (quantity) асуудал — OrderItem-тэй 1:1 холбож шийдсэн
//   3. Sale ба Rental нөөцийг ТУСГААРЛАСАН (sellStockQty / rentalStockQty)
//   4. Гар урлалын хөдөлмөрийн хөлсийг тусад нь загварчилсан (CraftLaborCost)
//   5. Төлбөрийн Gateway audit (GatewayTransaction) нэмсэн
//   6. Хэсэгчилсэн төлбөр (PARTIALLY_PAID + paidAmount) дэмжсэн
// Нэмэлтээр: walk-in харилцагчид login шаардахгүй болгосон, StockMovement
// түүх нэмсэн, RentalStatus/DepositStatus-д CANCELLED/PENDING нэмсэн.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. АЖИЛТАН (Login-той — зөвхөн ADMIN/CASHIER)
// ----------------------------------------------------------------------------
// ✅ ЗАСВАР: Хуучин "User" model нь энгийн үйлчлүүлэгчийг ч login хийлгэдэг
// байсан тул кассаар ирсэн зочин худалдан авагчийг бүртгэхэд эвгүй байсан.
// Одоо Staff (нэвтэрдэг) ба Customer (нэвтрэхгүй, зөвхөн утасны дугаараар
// бүртгэгддэг) гэж 2 тусдаа model болгосон.
// ============================================================================

enum StaffRole {
  ADMIN
  CASHIER
}

model Staff {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole @default(CASHIER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  orders         Order[]
  stockMovements StockMovement[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  address   String?
  idCardRef String? // Түрээсний барьцаанд зориулсан иргэний үнэмлэхийн лавлагаа
  notes     String?
  createdAt DateTime @default(now())

  orders Order[]
}

// ============================================================================
// 2. БҮТЭЭГДЭХҮҮН
// ============================================================================

// ============================================================================
// ✅ ШИНЭ: SHOP SETTINGS — Дэлгүүрийн банкны мэдээлэл (IBAN гэх мэт) зэрэг
// байнга өөрчлөгддөггүй ерөнхий тохиргоог хадгална. SINGLETON — id үргэлж
// "default" тул зөвхөн 1 мөр л байх ёстой (findFirst/upsert ашиглана).
// ============================================================================
// ============================================================================
// ✅ ШИНЭ: Хилийн бүсээс ГАДНА байрлалаас "Дэлгүүрийн хүргэлт" хүссэн
// хүсэлтүүдийг бүртгэнэ — бизнес хэрэв ийм хүсэлт олон гарвал бүсээ
// өргөтгөх шаардлагатай эсэхээ статистикаар шийдэхэд ашиглана.
// ============================================================================
model DeliveryBoundaryRejection {
  id            String   @id @default(uuid())
  latitude      Float
  longitude     Float
  customerPhone String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

model ShopSettings {
  id                String  @id @default("default")
  bankName          String?
  bankAccountNumber String?
  bankIban          String?
  bankAccountHolder String?
  shopAddress       String? // ✅ ШИНЭ — хэрэглэгч "очиж авна" сонговол харуулна
  shopPhone         String? // ✅ ШИНЭ — холбоо барих утас

  // ✅ ШИНЭ: Дэлгүүрийн БАЙРШИЛ (байршил баталгаажуулах лавлагаанд ашиглана)
  shopLatitude  Float?
  shopLongitude Float?

  // ✅ ЗАСВАР: Зайнаас (Haversine) АВТОМАТААР тооцдог байсныг больж,
  // БҮС (А/Б)-аар ХЭРЭГЛЭГЧ/КАССЧИН ГАРААР сонгуулдаг болгосон — учир нь
  // бодит бүсийн хил (жишээ: Хархорин<->Зүүн 4 зам, Зайсан<->32-ийн тойрог)
  // тойрог (radius) биш, гудамжны landmark-аар тодорхойлогддог.
  saleZoneAFee   Decimal @default(10000) @db.Decimal(12, 2) // УБ хот, А бүс — ЗАРАХ бараа
  saleZoneBFee   Decimal @default(15000) @db.Decimal(12, 2) // УБ хот, Б бүс — ЗАРАХ бараа
  rentalZoneAFee Decimal @default(50000) @db.Decimal(12, 2) // УБ хот, А бүс — ТҮРЭЭС (хүргээд, буцааж авна)
  rentalZoneBFee Decimal @default(100000) @db.Decimal(12, 2) // УБ хот, Б бүс — ТҮРЭЭС (хүргээд, буцааж авна)

  // ✅ ШИНЭ: Орон нутгийн унааны төлбөр (ЗӨВХӨН мэдээлэл — худалдан авагч
  // өөрөө унааны компанид очиж төлдөг тул манай Order.deliveryFee-д ОРОХГҮЙ)
  localTransportFee Decimal @default(15000) @db.Decimal(12, 2)

  // ✅ ШИНЭ: "Дэлгүүрийн хүргэлт"-ийн бүсийг тодорхойлох 4 хилийн цэг
  // (Баруун/Зүүн/Хойд/Урд) — эдгээрээс хамгийн бага/их lat/lng-ийг
  // тооцож, тэгш өнцөгт хилийн хайрцаг (bounding box) үүсгэнэ.
  deliveryBoundaryWestLat  Float? // Баруун — жишээ: Хархорин зах
  deliveryBoundaryWestLng  Float?
  deliveryBoundaryEastLat  Float? // Зүүн — жишээ: Офицеруудын ордон
  deliveryBoundaryEastLng  Float?
  deliveryBoundaryNorthLat Float? // Хойд — жишээ: 32-ын тойрог
  deliveryBoundaryNorthLng Float?
  deliveryBoundarySouthLat Float? // Урд — жишээ: Зайсан
  deliveryBoundarySouthLng Float?

  // ✅ ШИНЭ: GPS байршил авахад Бүс А/Б-г АВТОМАТААР санал болгоход
  // ашиглах радиус (дэлгүүрийн координатаас). Хэрэглэгч/кассчин ЗААВАЛ
  // хүсвэл өөрчилж болно — зөвхөн анхны санал (pre-select) л автомат.
  zoneAAutoRadiusKm Float @default(5)

  updatedAt DateTime @updatedAt
}

// ✅ ШИНЭ: Захиалгаа өөрөө очиж авах уу, хүргүүлэх үү
enum DeliveryMethod {
  PICKUP // Өөрөө очиж авна
  DELIVERY // ✅ ЗАСВАР: "Өөрсдийн унаа" — УБ хотын дотор, А/Б БҮСЭЭР тооцсон үнэ (SALE/RENTAL тус тусын хүснэгттэй)
  POST // Хөдөө орон нутаг ЭСВЭЛ УБ хотоос гадна — Монгол Шуудангаар (Шуудан хүртэл манайх ҮНЭГҮЙ хүргэнэ, цаашдын зардал тусад нь)
  LOCAL_TRANSPORT // Хөдөө орон нутагт унаагаар (Унааны буудал хүртэл манайх ТӨЛБӨРТЭЙ хүргэнэ, тэндээс цаашдыг харилцагч нэмж төлнө)
  UB_CAB // ✅ ШИНЭ — УБ хотод: харилцагч өөрөө UB Cab дуудаж манай хаягаас очиж авна (манай дүнд ОРОХГҮЙ)
}

// ============================================================================
// ✅ ШИНЭ: Хүргэлтийн ажилтны бүртгэл + хуваарилалтын төлөв
// ----------------------------------------------------------------------------
// Хуваарилалт HYBRID — аль аль нь боломжтой:
//   1) Broadcast → хэн түрүүлж Accept дарна, тэр авна (race condition-оос
//      хамгаалахтай — эхлээд шалгаад атомик update хийнэ)
//   2) Staff POS-оос тодорхой хүргэгчид ШУУД гараар оноож болно
// ============================================================================
enum DeliveryAssignStatus {
  UNASSIGNED // Хараахан хүргэгчдэд санал болгоогүй
  OFFERED // Бүх идэвхтэй хүргэгчид broadcast хийгдсэн, Accept хүлээж байна
  ASSIGNED // Аль нэг хүргэгч Accept дарсан (эсвэл Staff гараар оноосон)
  DELIVERED // Хүргэж дууссан
}

model Courier {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  pinHash   String // 4 оронтой PIN-ийг bcrypt-ээр хэшилнэ
  isActive  Boolean  @default(true) // Идэвхгүй болговол шинэ санал авахгүй
  createdAt DateTime @default(now())

  // ✅ ШИНЭ: Аюулгүй байдал — иргэний үнэмлэхний дугаар + Staff-ийн нүдэн
  // баталгаажуулалт (e-Mongolia албан ёсны зөвшөөрөл авах хүртэл ЭНЭ бол
  // хамгийн практик түр шийдэл).
  idCardNumber       String? // Иргэний үнэмлэхний дугаар (Staff бүртгэхдээ бичнэ)
  verificationStatus CourierVerificationStatus @default(PENDING)

  // ✅ ШИНЭ: Ажилтны барьцаа — RentalDetail-тэй ИЖИЛ DepositType ашиглана
  depositType       DepositType?
  depositAmount     Decimal              @default(0) @db.Decimal(12, 2)
  depositStatus     CourierDepositStatus @default(NONE)
  depositHeldAt     DateTime?
  depositReturnedAt DateTime?
  depositNote       String? // "Иргэний үнэмлэх хадгалж байна" гэх мэт тэмдэглэл

  // ✅ ШИНЭ: Хамгийн сүүлийн байршил — ЗӨВХӨН идэвхтэй хүргэлттэй үед л
  // курьер апп-аас илгээгдэнэ (ажилтны нууцлалыг хүндэтгэж байнга ХӨТЛӨХГҮЙ).
  currentLatitude          Float?
  currentLongitude         Float?
  currentLocationUpdatedAt DateTime?

  deviceTokens CourierDeviceToken[]
  deliveries   Order[]
}

enum CourierVerificationStatus {
  PENDING // Бүртгэгдсэн ч Staff нүдэн баталгаажуулаагүй
  VERIFIED // Иргэний үнэмлэхийг нь Staff шалгаж баталгаажуулсан
  REJECTED // Баталгаажуулалтад тэнцээгүй (ажиллуулахгүй)
}

enum CourierDepositStatus {
  NONE // Барьцаа аваагүй
  HELD // Барьцаа авсан (мөнгө эсвэл бичиг баримт)
  RETURNED // Ажлаас гарахад барьцааг буцаасан
}

/// Нэг хүргэгч хэд хэдэн төхөөрөмж (утас) дээр нэвтэрсэн байж болно —
/// FCM push бүгдэд нь илгээхийн тулд тус бүрийг тусад нь хадгална.
model CourierDeviceToken {
  id        String   @id @default(uuid())
  courierId String
  courier   Courier  @relation(fields: [courierId], references: [id])
  fcmToken  String   @unique
  platform  String? // "android" | "ios"
  createdAt DateTime @default(now())
}

model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Excel-ийн "id" баганыг хадгалж, дахин import хийхэд ЯГ ТЭР мөрийг
  // танихад (upsert) ашиглана — үгүй бол дахин ажиллуулах бүрт давхардал үүснэ.
  legacyId Int? @unique

  products Product[]

  @@index([parentId])
}

model Product {
  id          String  @id @default(uuid())
  name        String
  sku         String  @unique
  description String?

  // ---------- ✅ ШИНЭ: Өнгө, Хэмжээ тусдаа хайлт хийх боломжтой болгох ----------
  // Өмнө нь description-д нэгтгэж бичдэг байсан ("Өнгө: X | Хэмжээ: Y") —
  // одоо тусдаа багана болгон, хайлт/шүүлтүүрт шууд ашиглах боломжтой.
  color String?
  size  String?

  // ---------- ✅ ШИНЭ: Зураг + Ангилал (мод бүтэцтэй Category-руу холбоно) ----------
  imageUrl   String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // ---------- ✅ ЗАСВАР #1: Float → Decimal ----------
  // Мөнгөн дүнд Float ашиглавал 0.1+0.2=0.30000000000000004 мэт
  // дугуйруулалтын алдаа гардаг. Decimal(12,2) нь яг 2 орны нарийвчлалтай.
  sellPrice         Decimal? @db.Decimal(12, 2) // Борлуулах үнэ (RETAIL/HANDICRAFT)
  costPrice         Decimal  @default(0) @db.Decimal(12, 2) // Recipe+Labor-с автоматаар нийлбэрлэнэ
  rentalPricePerDay Decimal? @db.Decimal(12, 2)
  depositAmount     Decimal? @db.Decimal(12, 2) // Стандарт барьцааны хэмжээ

  isRental Boolean @default(false)
  isCraft  Boolean @default(false)

  // ---------- ✅ ЗАСВАР #3: Sale ба Rental нөөцийг тусгаарласан ----------
  // Хуучин схемд ганц "stock" талбар SALE-д ч, RENTAL-д ч ашиглагддаг байсан
  // тул нэг бараа хоёр процессоор зэрэг "зарагдаж" болзошгүй байсан.
  // Одоо 2 тусдаа сан:
  sellStockQty   Int  @default(0) // Шууд зарагдах нөөц (ширхэг)
  rentalStockQty Int? // Түрээслэгддэг биет ширхэгийн НИЙТ тоо

  minStockAlert Int      @default(3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ---------- ✅ ЗАСВАР #4: Гар урлалын өртөг — материал + хөдөлмөр ----------
  materialsUsed  CraftRecipe[]    @relation("ProductMaterials") // Энэ бүтээгдэхүүнд орсон түүхий эд
  usedAsMaterial CraftRecipe[]    @relation("MaterialSource") // Энэ бараа өөр бараанд түүхий эд болж орсон эсэх
  laborCosts     CraftLaborCost[]

  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([isRental])
  @@index([isCraft])
  @@index([categoryId])
}

// ============================================================================
// 3. ГАР УРЛАЛЫН ӨРТӨГ — Материал (BOM) + Хөдөлмөр
// ----------------------------------------------------------------------------
// ✅ ЗАСВАР #4: Хуучин CraftRecipe зөвхөн материалыг загварчилж, хөдөлмөрийн
// хөлсийг хуурамч "Product" үүсгэж оруулах шаардлагатай байв. Одоо
// CraftLaborCost гэсэн тусдаа model-оор цаг + цагийн хөлсийг шууд бичнэ.
// ============================================================================

model CraftRecipe {
  id         String  @id @default(uuid())
  productId  String // Бэлэн гар урлалын бүтээгдэхүүн
  product    Product @relation("ProductMaterials", fields: [productId], references: [id])
  materialId String // Зарцуулагдсан түүхий эд (мөн Product хүснэгтэд байна)
  material   Product @relation("MaterialSource", fields: [materialId], references: [id])

  quantity         Decimal @db.Decimal(10, 2) // жишээ: 2.5 метр
  unitCostSnapshot Decimal @db.Decimal(12, 2) // Орц бичсэн мөчийн нэгжийн үнэ
  // ^ "Snapshot" гэдэг нь чухал: хожим материалын үнэ өөрчлөгдөхөд өмнөх
  // тооцоолсон costPrice-ууд буруу өөрчлөгдөхөөс сэргийлнэ.

  @@index([productId])
}

enum LaborCostBasis {
  HOURLY // hours * hourlyRate
  FIXED // тогтмол дүн (жишээ: нэг ажлын хөлс)
}

model CraftLaborCost {
  id          String         @id @default(uuid())
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  description String // "Оёдол", "Будаж чимэглэх" гэх мэт
  basis       LaborCostBasis @default(HOURLY)
  hours       Decimal?       @db.Decimal(6, 2)
  hourlyRate  Decimal?       @db.Decimal(12, 2)
  fixedAmount Decimal?       @db.Decimal(12, 2)
  totalCost   Decimal        @db.Decimal(12, 2) // = hours*hourlyRate ЭСВЭЛ fixedAmount

  @@index([productId])
}

// Product.costPrice = SUM(CraftRecipe.quantity * unitCostSnapshot)
//                    + SUM(CraftLaborCost.totalCost)
// Энэ нийлбэрийг DB trigger ЭСВЭЛ app-level service-ээр CraftRecipe/
// CraftLaborCost бичигдэх бүрд дахин тооцож Product.costPrice-руу бичнэ.

// ============================================================================
// 4. НӨӨЦИЙН ХӨДӨЛГӨӨН (шинээр нэмэгдсэн)
// ----------------------------------------------------------------------------
// Хуучин схемд байхгүй байсан тул нөөц зөрөхөд яагаад/хэзээ өөрчлөгдснийг
// мөрдөх боломжгүй байв.
// ============================================================================

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RENTAL_OUT
  RENTAL_RETURN
  DAMAGE_LOSS
  ADJUSTMENT
  CRAFT_CONSUME // Гар урлал хийхэд түүхий эд зарцуулагдах үед
}

model StockMovement {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id])
  staffId          String?
  staff            Staff?            @relation(fields: [staffId], references: [id])
  type             StockMovementType
  quantity         Int
  referenceOrderId String?
  note             String?
  createdAt        DateTime          @default(now())

  @@index([productId])
  @@index([type])
}

// ============================================================================
// 5. ЗАХИАЛГА (ПОС + ОНЛАЙН нэгдсэн)
// ----------------------------------------------------------------------------
// ✅ ЗАСВАР #6: PayStatus-д PARTIALLY_PAID нэмж, paidAmount талбар нэмсэн —
// хагас төлбөртэй захиалгыг (жишээ: барьцаа бэлнээр, үлдэгдэл QPay-ээр)
// зөв хөтлөх боломжтой боллоо.
// ============================================================================

enum OrderType {
  POS
  ONLINE
}

enum PayStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  staffId    String? // Онлайн захиалгад staff байхгүй байж болно
  staff      Staff?    @relation(fields: [staffId], references: [id])

  orderType OrderType @default(POS)
  storeId   String    @default("default") // олон салбартай бол ашиглана

  totalAmount   Decimal   @db.Decimal(12, 2)
  paidAmount    Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus PayStatus @default(PENDING)

  // ✅ ШИНЭ: "Шинэ PAID захиалгуудыг нэг дор хэвлэх" функцэд ашиглана —
  // хэвлэгдсэн захиалгыг дахин хэвлэлтэнд оруулахгүй байхад хэрэглэнэ.
  isPrinted Boolean @default(false)

  // ✅ ШИНЭ: Хүргэлтийн мэдээлэл — customer/POS checkout дээр сонгоно
  deliveryMethod    DeliveryMethod @default(PICKUP)
  deliveryAddress   String?
  deliveryFee       Decimal        @default(0) @db.Decimal(12, 2)
  deliveryLatitude  Float? // ✅ ШИНЭ — "Байршил илгээх" товчоор ирсэн координат
  deliveryLongitude Float?

  // ✅ ШИНЭ: Хүргэлтийн ажилтны хуваарилалт (зөвхөн DELIVERY/UB_CAB зэрэг
  // манайх өөрөө хүргэдэг захиалгад хамаарна — POST/UB_CAB-д хэрэггүй)
  courierId            String?
  courier              Courier?             @relation(fields: [courierId], references: [id])
  deliveryAssignStatus DeliveryAssignStatus @default(UNASSIGNED)
  deliveryOfferedAt    DateTime? // Хүргэгчдэд санал болгосон (broadcast хийсэн) цаг
  deliveryAcceptedAt   DateTime? // Хүргэгч Accept дарсан цаг
  deliveredAt          DateTime? // Хүргэж дуусгасан цаг

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items               OrderItem[]
  payments            Payment[]
  gatewayTransactions GatewayTransaction[]

  @@index([paymentStatus])
  @@index([customerId])
}

// ============================================================================
// 6. ЗАХИАЛГЫН МӨР (Sale эсвэл Rental)
// ----------------------------------------------------------------------------
// ✅ ЗАСВАР #2: Хуучин RentalDetail нь Order+Product-той шууд холбогдож,
// quantity талбаргүй байсан тул "ижил барааг 2 ширхэг түрээслэвэл яах вэ?"
// гэдэг асуулт шийдэгдээгүй байв. Одоо OrderItem дээр quantity нэг л газар
// байж, RentalDetail нь ЯГ ТУХАЙН OrderItem-тэй 1:1 холбогдоно (доор харна
// уу) — давхардал арилж, quantity нэг эх сурвалжтай боллоо.
// ============================================================================

enum OrderItemType {
  SALE
  RENTAL
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemType  OrderItemType
  quantity  Int
  unitPrice Decimal       @db.Decimal(12, 2) // SALE бол sellPrice, RENTAL бол dailyRate огноо тутмын үнэ
  subtotal  Decimal       @db.Decimal(12, 2)

  // ✅ ШИНЭ: Бараа олгогдсон эсэх (Захиалгын түүхэнд харуулна). POS
  // захиалгад төлбөр орсон дор дор олгодог тул автоматаар true болно;
  // ONLINE захиалгад хэрэглэгч ирж авах хүртэл false үлдэнэ.
  isIssued Boolean   @default(false)
  issuedAt DateTime?

  rentalDetail RentalDetail? // itemType == RENTAL үед л энэ мөр үүснэ

  @@index([orderId])
  @@index([productId])
}

// ============================================================================
// 7. ТҮРЭЭСИЙН ДЭЛГЭРЭНГҮЙ
// ============================================================================

enum RentalStatus {
  BOOKED // Захиалсан (Онлайнаар эсвэл урьдчилж), бараа гараагүй
  ACTIVE // Түрээсэлж аваад явсан
  RETURNED // Буцаж ирсэн
  OVERDUE // Хугацаа хэтэрсэн боловч буцаагаагүй
  CANCELLED // ✅ Нэмэгдсэн — цуцлагдсан захиалга боломжийн тооцоонд орохгүй
}

enum DepositStatus {
  PENDING // ✅ Нэмэгдсэн — барьцааны мөнгө хараахан ирээгүй (QPay хүлээгдэж байна)
  HELD // Барьцаа бодитоор орж ирсэн, эзэмшигдэж байна
  PARTIALLY_REFUNDED // Гэмтэл/хожимдлын зардал суутгаад үлдсэнийг буцаасан
  FULLY_REFUNDED
  FORFEITED // Бүтэн хураагдсан
}

// ✅ ШИНЭ: Барьцаа мөнгөөр (QPay/бэлэн) уу, эсвэл бичиг баримтаар уу гэдгийг ялгана
enum DepositType {
  MONEY // QPay/SocialPay эсвэл кассчин бэлнээр хүлээн авсан
  DOCUMENT // Иргэний үнэмлэх/бусад бичиг баримт биетээр барьцаалсан
}

model RentalDetail {
  id          String    @id @default(uuid())
  orderItemId String    @unique
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  startDate    DateTime
  endDate      DateTime
  actualReturn DateTime?
  rentalDays   Int
  dailyRate    Decimal      @db.Decimal(12, 2)
  rentalStatus RentalStatus @default(BOOKED)

  overdueDays   Int     @default(0)
  lateFeePerDay Decimal @default(0) @db.Decimal(12, 2)
  penaltyFee    Decimal @default(0) @db.Decimal(12, 2) // = overdueDays * lateFeePerDay

  depositAmount       Decimal       @db.Decimal(12, 2)
  depositStatus       DepositStatus @default(PENDING)
  depositType         DepositType   @default(MONEY) // ✅ ШИНЭ
  documentDescription String? // ✅ ШИНЭ — жишээ: "Иргэний үнэмлэх"
  depositRefundAmount Decimal       @default(0) @db.Decimal(12, 2)
  damageFee           Decimal       @default(0) @db.Decimal(12, 2)
  damageNote          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gatewayTransactions GatewayTransaction[]

  @@index([rentalStatus])
  @@index([endDate]) // "хугацаа дуусаж буй захиалга" cron query-д
}

// ============================================================================
// 8. ТӨЛБӨР (Payment ledger) — ✅ ЗАСВАР #6-ийн үргэлжлэл
// ----------------------------------------------------------------------------
// Нэг Order дээр олон Payment мөр байж болно (жишээ: барьцаа CASH-аар,
// үлдэгдэл QPAY-ээр) — ингэснээр paidAmount яг юунаас бүрдсэнийг мөрдөнө.
// ============================================================================

enum PaymentMethod {
  CASH
  QPAY
  SOCIALPAY
  BANK_TRANSFER
  CARD
}

enum PaymentType {
  SALE_PAYMENT
  DEPOSIT
  DEPOSIT_REFUND
  LATE_FEE
}

model Payment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id])
  type      PaymentType
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  note      String?
  createdAt DateTime      @default(now())

  @@index([orderId])
  @@index([type])
}

// ============================================================================
// 9. ТӨЛБӨРИЙН GATEWAY AUDIT — ✅ ЗАСВАР #5
// ----------------------------------------------------------------------------
// QPay/SocialPay-ийн invoice_id, QR, webhook-ийн raw payload-ыг хадгална.
// Webhook давхардаж ирэхэд invoiceId-аар танин, дахин боловсруулахгүй
// байх (idempotency) боломжийг олгоно.
// ============================================================================

enum GatewayProvider {
  QPAY
  SOCIALPAY
}

enum GatewayPurpose {
  ORDER_PAYMENT
  DEPOSIT
  DEPOSIT_REFUND
}

enum GatewayTxStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

model GatewayTransaction {
  id         String          @id @default(uuid())
  provider   GatewayProvider
  purpose    GatewayPurpose
  invoiceId  String          @unique
  amount     Decimal         @db.Decimal(12, 2)
  status     GatewayTxStatus @default(PENDING)
  qrText     String?
  qrImageUrl String?

  orderId        String?
  order          Order?        @relation(fields: [orderId], references: [id])
  rentalDetailId String?
  rentalDetail   RentalDetail? @relation(fields: [rentalDetailId], references: [id])

  // ✅ ШИНЭ: Захиалгын үндсэн төлбөртэй ХАМТ (нэг QPay/Данс гүйлгээгээр)
  // төлөгдсөн Барьцаа(нуу)-ны RentalDetail id-үүд. Webhook/гараар
  // баталгаажихад энэ жагсаалт дахь БҮХ RentalDetail-ийг ч HELD болгоно.
  combinedDepositRentalIds String[] @default([])

  rawCallback Json?
  paidAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([orderId])
  @@index([rentalDetailId])
}
